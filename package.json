{
  "name": "@adiproject.dev/react-dynamic-form",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Build, render and validate dynamic JSON-schema-driven forms in React. Headless core, hooks, Tailwind renderers and a drag-and-drop form builder.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/muhaca/react-dynamic-form#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhaca/react-dynamic-form.git"
  },
  "bugs": {
    "url": "https://github.com/muhaca/react-dynamic-form/issues"
  },
  "keywords": [
    "react",
    "form",
    "dynamic-form",
    "json-schema",
    "form-builder",
    "form-builder-react",
    "react-hook-form",
    "tailwindcss"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind/index.d.ts",
        "default": "./dist/tailwind/index.js"
      },
      "require": {
        "types": "./dist/tailwind/index.d.cts",
        "default": "./dist/tailwind/index.cjs"
      }
    },
    "./builder": {
      "import": {
        "types": "./dist/builder/index.d.ts",
        "default": "./dist/builder/index.js"
      },
      "require": {
        "types": "./dist/builder/index.d.cts",
        "default": "./dist/builder/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev:playground": "vite --config playground/vite.config.ts",
    "dev:mock": "node mock-api/server.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "tailwindcss": ">=3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.51.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
